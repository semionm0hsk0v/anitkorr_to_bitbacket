MODULE_NAME=antikorr
ENV_FOR_DYNACONF=antikorr

API_HOST=127.0.0.1
API_PORT=8080
# PORT=8080  # Если задан, имеет приоритет над API_PORT.
API_ROOT=
API_MODE=DEV

VAULT_ENABLED_FOR_DYNACONF=false

LOGLEVEL=INFO
LOG_RENDERER=console
# LOG_JSON_INDENT=2
LOG_SPLIT_STDERR=true
LOG_STDERR_FROM=WARNING
ENABLE_FILE_LOG=false
LOG_DIR=logs
LOG_LLM_ONLY=true

# Локально — прямой RouterAI; dv переопределяет адрес в Helm values на llm-gateway.
# ROUTER_AI_BASE_URL=https://llm-gateway.dv.gigalegal.tech/v1
ROUTER_AI_BASE_URL=https://routerai.ru/api/v1
ROUTER_AI_API_KEY=

S3_SERVICE_BASE_URL=https://s3-service.dv.gigalegal.tech/
S3_SERVICE_ACCESS_TOKEN=

PROMPTS_DIR=src/agents/prompts
PROJECT_NAME=antikorr
PROJECT_TAG=default

BASE_MCP_URL=https://kb-mcp.dv.gigalegal.tech
KB_MCP_AUTH_TOKEN=
USE_KEYCLOAK=false
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=mcp-client
KEYCLOAK_CLIENT_SECRET=

MCP_TIMEOUT_S=45

# Langfuse Prompt Management. Без ключей шаблоны компилируются локально тем же SDK.
# Трейсинг документов отключён; здесь используется только получение шаблонов.
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PROMPT_LABEL=production
LANGFUSE_PROMPT_CACHE_TTL_SECONDS=300
LANGFUSE_PROMPT_FETCH_TIMEOUT_SECONDS=2
